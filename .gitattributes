# Every text file is kept with LF line endings on every system.
* text=auto eol=lf

# The files of the last runs are kept byte for byte as they were written.
results/** -text

# The page about the runs is prose, not program output: LF like every other text file.
results/README.md text eol=lf

# The same for the record of the testnet run: its files byte for byte, its page LF.
testnet/results/** -text
testnet/results/*/README.md text eol=lf
